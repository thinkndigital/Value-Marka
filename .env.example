# Copy this file to .env and fill in real values for local development.
# Never commit .env — it is already in .gitignore.
# In staging/production, these are set via Secret Manager / Cloud Run
# environment configuration, never checked into source control.

# ── Application ─────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (PostgreSQL / Cloud SQL) ───────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/valuemarka_dev?schema=public"

# Only needed when DATABASE_URL is a *pooled* connection (PgBouncer/Neon's
# "-pooler" endpoint/Supabase's "Connection pooling" string/Vercel Postgres'
# POSTGRES_URL) — `prisma migrate deploy` takes a Postgres advisory lock,
# which requires a session-level (unpooled) connection and will time out
# with error P1002 against a pooled one. Set this to the same database's
# direct/unpooled connection string (Neon: the endpoint without "-pooler";
# Supabase: the "Direct connection" string, usually port 5432; Vercel
# Postgres: POSTGRES_URL_NON_POOLING). Leave unset — as with a local, single
# Postgres instance — and migrations fall back to DATABASE_URL.
# DIRECT_URL="postgresql://user:password@localhost:5432/valuemarka_dev?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32+-character-secret"

# Encrypts Server Action closures (e.g. every `.bind(null, id)` action
# throughout the admin/seller UIs). Next.js generates a random one per
# process if unset — fine for a single instance, but on Cloud Run with
# multiple instances an action encrypted by one instance can fail to
# decrypt on another. Required in production; generate with:
#   openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Bootstraps the first SUPER_ADMIN account (prisma/seed.ts), so there's a
# real way in before any admin exists to grant that role through the UI.
# Only takes effect when both are set — leave unset to skip entirely.
# Password must satisfy the same rule registration enforces: 8+ characters,
# at least one letter and one number (src/server/auth/schemas.ts).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="User"

# ── Google Cloud ─────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_CLOUD_STORAGE_BUCKET=""
# A separate, non-public bucket for digital-product files — see
# DEPLOYMENT.md §1.4b. Must not be the same bucket as the one above.
GOOGLE_CLOUD_STORAGE_PRIVATE_BUCKET=""
# Path to a service account key JSON file (local dev only — in GCP use
# Workload Identity / the Cloud Run service account instead of a key file).
GOOGLE_APPLICATION_CREDENTIALS=""

# ── Payments: Stripe (Connect) ──────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# ── Payments: PayPal ─────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENV="sandbox" # sandbox | live

# ── Email ────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER: smtp | resend | sendgrid | mailgun
EMAIL_PROVIDER="smtp"
EMAIL_FROM="Value Marka <no-reply@example.com>"
EMAIL_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ── SMS ──────────────────────────────────────────────────────────────────
# SMS_PROVIDER: twilio | messagebird
SMS_PROVIDER="twilio"
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_FROM_NUMBER=""

# ── Background jobs (Cloud Tasks) ───────────────────────────────────────
CLOUD_TASKS_QUEUE=""
CLOUD_TASKS_LOCATION=""
CLOUD_TASKS_HANDLER_URL=""

# ── Scheduled jobs (Cloud Scheduler → HTTP) ─────────────────────────────
# Shared secret Cloud Scheduler sends as a Bearer token when it calls
# /api/cron/*. Generate with: openssl rand -base64 32
CRON_SECRET=""

# ── Search (future: Meilisearch/Algolia adapter) ────────────────────────
SEARCH_PROVIDER="postgres"
MEILISEARCH_HOST=""
MEILISEARCH_API_KEY=""

# ── Observability ────────────────────────────────────────────────────────
SENTRY_DSN=""
